    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_sangse.jpeg",
    "scheme": "appmobilesangse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "SUPABASE_URL": "https://bdeahexcoljgxdpbxvve.supabase.co",
      "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJkZWFoZXhjb2xqZ3hkcGJ4dnZlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDg1MjI3OTksImV4cCI6MjA2NDA5ODc5OX0.1gDZZQnDCDAXx7vWM0rVWPB3XGc9MTY-OsnmR9TgD54",
      "router": {},
      "eas": {
